[Unit]
Description=RillDNS query telemetry
After=network-online.target
Wants=network-online.target
Before=rilldns.service

[Service]
Type=simple
User={{ rilldns_user }}
Group={{ rilldns_group }}
UMask=0077
ExecStart=/usr/local/bin/rill-telemetry -dnstap-listen 127.0.0.1:6000 -metrics-listen 127.0.0.1:19154 -blocklist /var/lib/rilldns/blocking/merged.hosts -analytics-mode {{ rilldns_query_analytics_mode }} -analytics-retention {{ rilldns_query_analytics_retention }} -analytics-state /var/lib/rilldns/query-analytics.json -analytics-max-domains {{ rilldns_query_analytics_max_domains }} -analytics-max-clients {{ rilldns_query_analytics_max_clients }} -analytics-recent-queries {{ rilldns_query_analytics_recent_queries }}
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rilldns
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
