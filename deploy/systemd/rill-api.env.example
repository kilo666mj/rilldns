# Browser UI and OIDC authentication.
RILLDNS_UI_LISTEN=0.0.0.0:8083
RILLDNS_OIDC_ISSUER=https://id.example.net
RILLDNS_OIDC_CLIENT_ID=replace-with-pocket-id-client-id
RILLDNS_OIDC_CLIENT_SECRET=replace-with-pocket-id-client-secret
RILLDNS_OIDC_REDIRECT_URL=https://dns.example.net/api/auth/callback
RILLDNS_OIDC_SCOPES=openid,profile,email
# Required authorization restriction: configure at least one non-empty list.
# Subject IDs are preferred because email claims may change between logins.
# Email authorization is intentionally unsupported; use immutable subjects or groups.
RILLDNS_OIDC_ALLOWED_EMAILS=
RILLDNS_OIDC_ALLOWED_GROUPS=
RILLDNS_OIDC_ALLOWED_SUBJECTS=
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
RILLDNS_SESSION_KEY=replace-with-32-byte-base64url-key

# HA visibility. Configure the peer's read-only metrics listener; never point
# this at the authenticated UI or loopback management listener.
RILLDNS_HA_NODE=dns-primary
RILLDNS_HA_ROLE=active
RILLDNS_HA_PEER_NAME=dns-secondary
RILLDNS_HA_PEER_HEALTH_URL=http://192.0.2.11:18053/healthz
RILLDNS_HA_PEER_STATUS_URL=http://192.0.2.11:18053/v1/status/ha
RILLDNS_HA_VIP=192.0.2.53

# Optional read-only Cloudflare DNS integration. The token itself belongs in a
# separate root-owned file readable by the rilldns group, never in this file.
# RILLDNS_CLOUDFLARE_ZONES=example.com,example.net
# RILLDNS_CLOUDFLARE_TOKEN_FILE=/etc/rilldns/cloudflare.token
