RILLDNS_UI_LISTEN=0.0.0.0:8083
RILLDNS_OIDC_ISSUER=https://id.example.net
RILLDNS_OIDC_CLIENT_ID=replace-with-pocket-id-client-id
RILLDNS_OIDC_CLIENT_SECRET=replace-with-pocket-id-client-secret
RILLDNS_OIDC_REDIRECT_URL=https://dns.example.net/api/auth/callback
RILLDNS_OIDC_SCOPES=openid,profile,email
# Optional comma-separated authorization restrictions. Configure at least one.
RILLDNS_OIDC_ALLOWED_EMAILS=
RILLDNS_OIDC_ALLOWED_GROUPS=
RILLDNS_OIDC_ALLOWED_SUBJECTS=
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
RILLDNS_SESSION_KEY=replace-with-32-byte-base64url-key
