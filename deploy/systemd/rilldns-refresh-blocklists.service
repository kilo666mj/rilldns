[Unit]
Description=Refresh RillDNS DNS blocklists
After=network-online.target rilldns.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/rilldns/blocklists.env
ExecStart=/usr/local/bin/rill-blocklist-refresh
User=rilldns
Group=rilldns
UMask=0077
Nice=10
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rilldns
