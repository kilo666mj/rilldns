[Unit]
Description=Generate CoreDNS cache exclusions for authoritative zones
# The path unit fires once per zone file written, so a multi-zone install
# would otherwise trip the default start rate limit and leave this failed.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=rilldns
Group=rilldns
UMask=0077
ExecStartPre=+/usr/bin/install -d -o rilldns -g rilldns -m 0750 /var/lib/rilldns/zones
ExecStart=/usr/local/bin/rill-cache-zones
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rilldns
