[Unit]
Description=Validate RillDNS primary authoritative zones
After=network-online.target rilldns.service
Requires=rilldns.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rill-zone-status
User=rilldns
Group=rilldns
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rilldns
